{
	"name": "rookie-chess",
	"version": "0.5.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"postinstall": "node scripts/copy-engine.js",
		"icons": "pwa-assets-generator",
		"test:account": "npm run build && playwright test -c playwright.account.config.ts",
		"dev:api": "npm run build && wrangler pages dev build --d1 DB=rookie-local --compatibility-date=2026-11-01"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261110.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vite-pwa/sveltekit": "^2.0.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.6.0",
		"magicast": "^0.5.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.160.0"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@lucide/svelte": "^1.71.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.1.0",
		"chessground": "^9.2.1",
		"chessops": "^0.15.1",
		"dexie": "^4.4.7",
		"stockfish": "^19.0.1",
		"ts-fsrs": "^5.4.2"
	},
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": ">=22"
	}
}
